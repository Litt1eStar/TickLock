# Tick Lock 3D Backend Configuration
# Copy to .env and adjust before deploying on a VPS.

PORT=8642
HOST=0.0.0.0
DB_PATH=./data/ticklock.sqlite

# 'openhouse' tags runs with Open House 2026 and allows booth scoreboard clearing.
# Switch to 'public' on your VPS after copying data/ticklock.sqlite from the booth.
TICKLOCK_MODE=openhouse

# Required when TICKLOCK_MODE=public to protect POST /api/admin/clear-today.
ADMIN_KEY=

# Optional on the booth laptop: mirror plays and finished runs to your live VPS in real time.
# Example: UPSTREAM_URL=https://ticklock.example.com
UPSTREAM_URL=
